@startuml

package Library-Facade {

  abstract class IProvider {
  }

  abstract class IImagesPathsDBProvider {
    +{abstract} ImageRecordsSet& get_images_db()
    +{abstract} std::string get_db_path()
    +{abstract} AnnotationsList get_available_annotations()
    +{abstract} bool changed()
    +{abstract} bool delete_image_record(const std::string& irFullPath)
  }

  abstract class IAnnotationsDB {
    +{abstract} bool load_db(const std::string& fpath)
    +{abstract} bool store_db()
    +{abstract} bool store_db(const std::string& fpath)
    +{abstract} void add_images_db(const ImageRecordsSet& andb)
    +{abstract} void set_app_info(const std::string& name, const std::string& version)
    +{abstract} std::string get_app_name()
    +{abstract} std::string get_app_version()
  }

  abstract class IRecordsFactory {
    +{abstract} ImageRecordPtr create_image_record(nirpath, nabsPath)
    +{abstract} ImageRecordRectPtr create_image_rect_record(ir)
    +{abstract} ImageRecordRectPtr create_image_rect_record(nname, nx, ny, nwidth, nheight)
  }

  abstract class IDBMerger {
    +{abstract} void merge(ImageRecordsSet& dst, const ImageRecordsSet& append)
  }

  abstract class IADataDriversLib {
    +{abstract} bool libcall(IADataDriversContextPtr ctx)
  }

  class IADataDriversContext {
    +std::string db_path
    +std::string app_name
    +std::string app_version
    +IRecordsFactoryPtr records_factory
    +IDBMergerPtr merger
    +IAnnotationsDBPtr db
    +{static} IADataDriversContextPtr create()
  }

  class ImageRecord {
    +std::string abs_dir_path
    +std::string path
    +std::filesystem::path tmppath
    +ImageRecordRectSet rects
    +ImageRecordRectPtr current_rect
    +int iwidth
    +int iheight
    +double imageScale
    +std::string get_full_path()
    +ImageRecordPtr duplicate_shared()
  }

  class ImageRecordRect {
    +std::string name
    +int x
    +int y
    +int width
    +int height
    +ImageRecordRectPtr duplicate_shared()
  }

  class IADataDriversFacade {
    +{static} IADataDriversContextPtr create_library_context()
    +{static} IADataDriversLibPtr create_default_lib()
    +{static} IADataDriversLibPtr create_library(IADataDriversContextPtr ctx)
    +{static} IAnnotationsDBPtr create_annotations_db()
    +{static} IAnnotationsDBPtr create_annotations_db(IADataDriversContextPtr ctx)
    +{static} IAnnotationsDBPtr open_annotations_db(const std::string& fpath)
    +{static} IRecordsFactoryPtr create_records_factory()
    +{static} IDBMergerPtr create_db_merger()
    +{static} std::string library_version()
    +{static} std::string default_db_root_app_name()
    +{static} std::string default_db_app_version()
  }
}

package Library-Implementation {

  class LibMain <<lib0impl>> {
    +bool libcall(IADataDriversContextPtr ctx)
    +{static} LibMainPtr create()
  }

  class LibFactory <<lib0impl>> {
    +IADataDriversLibPtr create_default_lib()
    +IADataDriversContextPtr create_default_context()
    +IADataDriversLibPtr create_appropriate_lib(IADataDriversContextPtr ctx)
    +IAnnotationsDBPtr create_annotations_db()
    +IAnnotationsDBPtr create_annotations_db(IADataDriversContextPtr ctx)
    +IRecordsFactoryPtr create_records_factory()
    +IDBMergerPtr create_db_merger()
    +{static} LibFactoryPtr create_factory()
  }

  class AnnotationsDirDB <<iannotator::dbs::annotations>> {
    +bool load_db(const std::string& fpath)
    +bool store_db()
    +bool store_db(const std::string& fpath)
    +void add_images_db(const ImageRecordsSet& andb)
    +void set_records_factory(IRecordsFactoryPtr factory)
    +void set_db_merger(IDBMergerPtr merger)
    +void set_library_impl(LibraryImplPtr newImpl)
    +{static} AnnotationsDirDBPtr create()
    ..
    #LibraryImplPtr impl
    #ImageRecordsSet irdb
    #ImageRecordsSet last_saved_db
    #std::string current_db_path
  }

  class LibraryImpl <<iannotator::dbs::annotations>> {
    +bool load(const std::string& fpath, ImageRecordsSet& irdb)
    +bool store(const std::string& fpath, const ImageRecordsSet& irdb)
    +void set_app_info(const std::string& name, const std::string& version)
    +void set_records_factory(IRecordsFactoryPtr factory)
    +{static} LibraryImplPtr create()
    ..
    #bool serialize(const nlohmann::json& json)
    #ImageRecordsSet load_the_irs(const nlohmann::json& json)
    #std::string app_name
    #std::string app_version
  }

  class AnnotationsJSONSerializator <<iannotator::dbs::annotations>> {
    +bool serialize(const nlohmann::json& json)
    +std::string root_app_name
    +std::string app_version
    +{static} default_root_app_name
    +{static} default_app_version
    ..
    #bool serialize_app_info(const nlohmann::json& json)
    #bool serialize_annotations_records(const nlohmann::json& json)
  }

  class Converters <<the four JSON converters>> {
    JSON2ImageRecordsConverter
    ImageRecords2JSONConverter
    ImageRecordJSON2RecordConverter
    ImageRecordRectJSON2RecordConverter
    ..
    +ImageRecordsSet fetch_records(const nlohmann::json& allAJSon)
    +bool store(const ImageRecordsSet& irs, const std::string& filepath)
    +ImageRecordPtr convert(const nlohmann::json& fan, const std::string& absdirpath)
    +ImageRecordRectPtr convert(const nlohmann::json& rect)
  }

  class RecordsFactory <<iannotator::records>> {
    +ImageRecordPtr create_image_record(nirpath, nabsPath)
    +ImageRecordRectPtr create_image_rect_record(ir)
    +ImageRecordRectPtr create_image_rect_record(nname, nx, ny, nwidth, nheight)
    +{static} RecordsFactoryPtr create()
  }

  class DefaultDBMerger <<iannotator::dbs::annotations::merger>> {
    +void merge(ImageRecordsSet& dst, const ImageRecordsSet& append)
    +{static} DefaultDBMergerPtr create()
  }
}

note Left of IADataDriversFacade : The facade of the library implementation.\nThe single entry point of a consuming project:\nevery method is static and hands back\nan abstract interface only.

note Left of IADataDriversContext : The data placeholder passed in and out\nof IADataDriversLib::libcall. Holds the db path, the\napplication identity and the optional custom\nrecords factory and merger. Filled with the\nANNOTATIONS_DB_ROOT_APP_NAME and the\nANNOTATIONS_DB_APP_VERSION defaults.

note Bottom of IADataDriversLib : The particular library implementation interface declearer.

note Right of IProvider : IProvider and IRecord are the empty tagging\nbases every provider and every data record\nof the public API is built upon.

note Right of LibMain : The particular library implementation.\nIs created by LibFactory to return\nby IADataDriversFacade to the end user.

note Bottom of LibFactory : The factory to create library implementations objects.\nEvery class of this package is instantiated through it.

note Right of AnnotationsDirDB : The annotations project database itself:\nkeeps the in memory records set and knows\nnothing of the format they were read from.

note Right of LibraryImpl : The project file driver of the JSON format.\nEverything the library knows about the file\nformat lives here, so another format is a\ndescendant of this class.

note Bottom of DefaultDBMerger : Appends the not yet present records only.\nThe paths are resolved through\nhelpers::ImageRecordUrlAndPathHelper, which\nasks helpers::UrlHelper about the web URLs.

IProvider <|-- IImagesPathsDBProvider : extends
IImagesPathsDBProvider <|-- IAnnotationsDB : extends

ImageRecord *-- ImageRecordRect : rects
IImagesPathsDBProvider ..> ImageRecord : provides the records set of
IRecordsFactory ..> ImageRecord : creates
IRecordsFactory ..> ImageRecordRect : creates

IADataDriversContext o-- IRecordsFactory : in
IADataDriversContext o-- IDBMerger : in
IADataDriversContext o-- IAnnotationsDB : out
IADataDriversLib ..> IADataDriversContext : takes and fills

IADataDriversFacade ..> IADataDriversContext : creates
IADataDriversFacade --> LibFactory : delegates every call to

IADataDriversLib <|-- LibMain : Particular implementation
IAnnotationsDB <|-- AnnotationsDirDB : implements
IRecordsFactory <|-- RecordsFactory : implements
IDBMerger <|-- DefaultDBMerger : implements

LibMain --> LibFactory : builds the database through
LibFactory ..> LibMain : creates
LibFactory ..> AnnotationsDirDB : creates
LibFactory ..> RecordsFactory : creates
LibFactory ..> DefaultDBMerger : creates

AnnotationsDirDB --> LibraryImpl : reads and writes the project file through
LibraryImpl --> AnnotationsJSONSerializator : validates the file with
LibraryImpl --> Converters : converts the JSON with
AnnotationsDirDB --> IDBMerger : add_images_db merges with
AnnotationsDirDB ..> DefaultDBMerger : the default merger

Converters --> IRecordsFactory : builds every record through

@enduml
